#!/bin/sh
set -eu
before=$(git write-tree)
"$(git rev-parse --show-toplevel)/.githooks/pre-commit"
# git merge can retain the tree it computed before this hook changed the index.
if [ "$before" != "$(git write-tree)" ]; then
  echo 'Graph rebuilt and staged. Run git commit to finish this merge.' >&2
  exit 1
fi
