{
  "include": ["app/**/*.ts", "app/**/*.tsx", "db/**/*.ts", "worker/**/*.ts", "tests/**/*.ts", "*.ts", ".react-router/types/**/*"],
  "exclude": ["node_modules", "build"],
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client", "@cloudflare/workers-types"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "isolatedModules": true
  }
}
