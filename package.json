{
  "name": "stream-bullets",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:test": "CLOUDFLARE_ENV=test react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "start": "wrangler dev --config build/server/wrangler.json --port 5173",
    "check": "react-router typegen && tsc --noEmit",
    "lint": "eslint app db worker tests scripts *.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "pnpm build:production && wrangler deploy --config build/server/wrangler.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "better-auth": "1.7.17",
    "@better-auth/drizzle-adapter": "1.7.23",
    "drizzle-orm": "0.45.4",
    "radix-ui": "1.8.1",
    "lucide-react": "1.71.0",
    "zod": "4.6.7",
    "image-size": "2.1.0",
    "@simplewebauthn/server": "14.1.0",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "marked": "18.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261113.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "@eslint/js": "10.0.1",
    "vite": "8.3.8",
    "wrangler": "4.158.0",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@playwright/test": "1.65.0",
    "miniflare": "4.20260730.0",
    "esbuild": "0.28.2",
    "react-server-dom-webpack": "19.3.1",
    "@types/three": "0.187.0",
    "monocart-coverage-reports": "3.2.1"
  }
}
